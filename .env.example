# ==============================================================================
# Crownfall Environment Configuration Example
# Copy this file to .env.local for local development or set in Render dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Render Static Site Build Environment)
# ------------------------------------------------------------------------------
# In production on Render, set this to your Render Web Service domain.
# Either VITE_WS_URL or VITE_MULTIPLAYER_SERVER_URL is accepted by the frontend.
# The client automatically handles wss:// (WebSocket) and https:// (HTTP health check / REST).
#
# Production example:
VITE_WS_URL=wss://crownfall-server.onrender.com
VITE_MULTIPLAYER_SERVER_URL=https://crownfall-server.onrender.com
#
# Cloudflare Turnstile Public Site Key (Frontend client widget)
# Create a free Turnstile site at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave empty to disable Turnstile widget on client
VITE_TURNSTILE_SITE_KEY=

# Local development default:
# VITE_WS_URL=ws://localhost:8444
# VITE_MULTIPLAYER_SERVER_URL=http://localhost:8444

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render Web Service / Local Server)
# ------------------------------------------------------------------------------
# Render dynamically injects PORT. For local server testing, default is 8444.
PORT=10000

# Network interface to bind to:
# Render Web Services require 0.0.0.0
HOST=0.0.0.0

# Node.js environment
NODE_ENV=production

# Reverse proxy client IP resolution:
# Set to 'true' on Render, Fly.io, Railway, or AWS behind a reverse proxy.
# Trusts X-Forwarded-For and X-Real-IP headers.
TRUST_PROXY=true

# Maximum concurrent WebSocket client connections
MAX_CONNECTIONS=500

# Administrative API secret key for privileged room closing and security log inspection
ADMIN_API_KEY=crownfall-admin-secret-change-me

# ------------------------------------------------------------------------------
# SECURITY, BOT FRICTION & RATE LIMITING CONFIGURATION
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Secret Key (Server-side verification)
# Stored securely in environment variables; never exposed to frontend code or client bundles.
# If omitted or left empty, Turnstile verification will gracefully pass in development.
TURNSTILE_SECRET_KEY=

# CAPTCHA enforcement mode:
# 'auto' (default): Required for room creation and suspicious repeated failed joins
# 'always': Enforced unconditionally for all room creation and join attempts
# 'disabled': Turnstile verification completely disabled (development only)
CAPTCHA_ENFORCEMENT=auto

# Action category token-bucket rate limits (Burst Tokens / Refill Rate Per Second):
# Room creation: default burst 5, refill ~1 token per 120s (~5 per 10m)
RATE_LIMIT_ROOM_CREATE_BURST=5
RATE_LIMIT_ROOM_CREATE_RATE=0.00833

# Room joins: default burst 15, refill ~1 token per 4s (~15 per min)
RATE_LIMIT_ROOM_JOIN_BURST=15
RATE_LIMIT_ROOM_JOIN_RATE=0.25

# Host join responses: default burst 30, refill ~1 token per 2s (~30 per min)
RATE_LIMIT_JOIN_RESPOND_BURST=30
RATE_LIMIT_JOIN_RESPOND_RATE=0.5

# Reconnect attempts: default burst 20, refill ~1 token per 3s (~20 per min)
RATE_LIMIT_RECONNECT_BURST=20
RATE_LIMIT_RECONNECT_RATE=0.33

# In-game player actions: default burst 25, refill 5 tokens per second
RATE_LIMIT_GAMEPLAY_BURST=25
RATE_LIMIT_GAMEPLAY_RATE=5.0

# General HTTP API requests: default burst 100, refill 2 tokens per second
RATE_LIMIT_GENERAL_BURST=100
RATE_LIMIT_GENERAL_RATE=2.0

# Optional path override for native C++ binary (auto-detected if omitted)
# ENGINE_BIN_PATH=/app/bin/monopoly_engine
