# ==============================================================================
# Crownfall Environment Configuration Example
# Copy this file to .env.local for local development or set in Render dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Render Static Site Build Environment)
# ------------------------------------------------------------------------------
# In production on Render, set this to your Render Web Service domain.
# Either VITE_WS_URL or VITE_MULTIPLAYER_SERVER_URL is accepted by the frontend.
# The client automatically handles wss:// (WebSocket) and https:// (HTTP health check / REST).
#
# Production example:
VITE_WS_URL=wss://crownfall-server.onrender.com
VITE_MULTIPLAYER_SERVER_URL=https://crownfall-server.onrender.com
#
# Local development default:
# VITE_WS_URL=ws://localhost:8444
# VITE_MULTIPLAYER_SERVER_URL=http://localhost:8444

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render Web Service / Local Server)
# ------------------------------------------------------------------------------
# Render dynamically injects PORT. For local server testing, default is 8444.
PORT=10000

# Network interface to bind to:
# Render Web Services require 0.0.0.0
HOST=0.0.0.0

# Node.js environment
NODE_ENV=production

# Maximum concurrent WebSocket client connections
MAX_CONNECTIONS=500

# Optional path override for native C++ binary (auto-detected if omitted)
# ENGINE_BIN_PATH=/app/bin/monopoly_engine
