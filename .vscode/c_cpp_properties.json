  "configurations": [
    {
      "name": "Win32",
      "includePath": [
        "${workspaceFolder}/cpp/include",
        "${workspaceFolder}/**"
      ],
      "defines": [
        "_DEBUG",
        "UNICODE",
        "_UNICODE"
      ],
      "cStandard": "c17",
