    {
      "A4": "Money convention",
      "B4": "All monetary values are rounded UP to the next \u20b9100 multiple."
    },
    {
      "A5": "City data source status",
      "B5": "Sourced / estimated status is retained in City Properties."
    },
    {
      "A6": "Historical spelling",
      "B6": "Preserve: Bombay, Madras, Bangalore, Kolkatta, Margoa, Ootacamund, Chandigadh."
    },
    {
      "A7": "Board order",
      "B7": "Exact 36-space board order/indices are intentionally not included yet; use the physical board as the authoritative source."
    },
    {
      "A8": "Special property count",
      "B8": "6: Railway, Roadways, Electrical Company, Air India, Water Works, Motor Boat."
    },
    {
      "A9": "Chance / Chest mechanic",
      "B9": "Dice SUM selects the declaration; no physical cards are used."
    },
    {
      "A10": "Important",
      "B10": "Do not silently replace estimated city rent/building values with values from newer Business editions."
    }
